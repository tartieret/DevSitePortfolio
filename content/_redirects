# Netlify redirects, generated by Pelican from content/_redirects.
#
# The site's URLs are extensionless (ARTICLE_URL in pelicanconf.py). Search
# engines indexed the old .html form too, so send each one permanently to the
# clean URL. "!" forces the rule even though the .html file exists on disk.

/index.html  /  301!
/blog.html  /blog  301!
{% for n in range(2, (articles|length - 1) // DEFAULT_PAGINATION + 2) %}
/blog{{ n }}.html  /blog{{ n }}  301!
{% endfor %}
{% for page in pages if page.url %}
/{{ page.url }}.html  /{{ page.url }}  301!
{% endfor %}
{% for article in articles %}
/{{ article.url }}.html  /{{ article.url }}  301!
{% endfor %}
{% for category, _ in categories %}
/{{ category.url }}.html  /{{ category.url }}  301!
{% endfor %}
{% for tag, _ in tags %}
/{{ tag.url }}.html  /{{ tag.url }}  301!
{% endfor %}
{% for author, _ in authors %}
/{{ author.url }}.html  /{{ author.url }}  301!
{% endfor %}

